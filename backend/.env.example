# Backend Environment Variables
# Copy this file to .env and update with your values

NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=mongodb://despensalista_app:change-this-app-password@127.0.0.1:37917/despensalista?authSource=despensalista&replicaSet=rs0&directConnection=true
DATABASE_NAME=despensalista
# Requires a replica set for atomic mutations. The local compose starts rs0.
# directConnection=true is for this single-node Docker host-port mapping only.
# Leave MONGO_HOST unset when using the explicit URL above.

# API Configuration
API_PREFIX=api

# CORS Configuration
CORS_ORIGIN=http://localhost:4200

# Helmet Security Headers
HELMET_ENABLED=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120
RATE_LIMIT_TIME_WINDOW=1 minute
RATE_LIMIT_TRUST_PROXY=false

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_TITLE=PantryList API
SWAGGER_DESCRIPTION=API for managing household products and shopping schedules
SWAGGER_VERSION=1.0

# Notes
# Use a real MongoDB connection string for Dokploy or Atlas deployments.
